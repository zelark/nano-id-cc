{
  "name": "nano-id-cc",
  "version": "0.1.0",
  "private": true,
  "description": "NanoID Collision Calculator",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "minify:css": "esbuild public/css/style.css --minify --outfile=public/css/style.min.css",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/calc.test.ts src/format.test.ts src/alphabets.test.ts",
    "dev": "npm run minify:css && esbuild src/main.ts --bundle --watch --servedir=public --outdir=public/js"
  },
  "dependencies": {
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
